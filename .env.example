# Development-only configuration. Never reuse these values outside localhost.
NEXORA_ENVIRONMENT=development
NEXORA_LOG_LEVEL=info

# Sample services
# Compose sets NEXORA_HTTP_ADDR per service (:8080 for hello-service and
# 0.0.0.0:8081 for core-template). Export it yourself for manual runs.
# NEXORA_HTTP_ADDR=:8080
NEXORA_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
NEXORA_SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL 17 (transactional system of record)
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (cache only; never authoritative)
REDIS_HOST=localhost
REDIS_PORT=6379

# Redpanda (Kafka API)
REDPANDA_BROKERS=localhost:9092

# ClickHouse (analytics; never authorizes financial actions)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=nexora
CLICKHOUSE_PASSWORD=nexora_dev_only

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=nexora
MINIO_ROOT_PASSWORD=nexora_dev_only_change_me

# OTLP collector
# The sample services read NEXORA_OTEL_EXPORTER_OTLP_ENDPOINT above.

# B03 identity service (local development only).
# Compose enables intentionally ephemeral keys and development token exposure.
# For manual runs, provide all five 32-byte secrets as base64 and an Ed25519
# private-key PEM file; staging and production reject ephemeral key material.
NEXORA_IDENTITY_DATABASE_URL=postgres://nexora:nexora_dev_only@localhost:5432/nexora?sslmode=disable
NEXORA_HTTP_ADDR=:8082
NEXORA_IDENTITY_GRPC_ADDR=:9090
NEXORA_IDENTITY_ALLOW_EPHEMERAL_KEYS=true
NEXORA_IDENTITY_EXPOSE_DEV_TOKENS=true
NEXORA_IDENTITY_AUTO_MIGRATE=true
NEXORA_IDENTITY_WEBAUTHN_RP_ID=localhost
NEXORA_IDENTITY_WEBAUTHN_RP_ORIGINS=http://localhost:8082
# NEXORA_IDENTITY_JWT_PRIVATE_KEY_FILE=/run/secrets/identity-jwt.pem
# NEXORA_IDENTITY_PASSWORD_PEPPER=<base64 32 bytes>
# NEXORA_IDENTITY_PII_PEPPER=<base64 32 bytes>
# NEXORA_IDENTITY_IP_PEPPER=<base64 32 bytes>
# NEXORA_IDENTITY_PII_KEY=<base64 32 bytes>
# NEXORA_IDENTITY_SECRET_KEY=<base64 32 bytes>
# NEXORA_IDENTITY_GRPC_TLS_CERT_FILE=/run/secrets/grpc-server.crt
# NEXORA_IDENTITY_GRPC_TLS_KEY_FILE=/run/secrets/grpc-server.key
# NEXORA_IDENTITY_GRPC_CLIENT_CA_FILE=/run/secrets/grpc-client-ca.crt
